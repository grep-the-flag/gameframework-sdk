{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grep-the-flag.github.io/gameframework-sdk/event.schema.json",
  "title": "event.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "id", "version", "name", "story", "scoring", "unlock_mode", "challenges"],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"type": "string", "pattern": "^>=\\d+\\.\\d+,<\\d+\\.\\d+$", "description": "SDK contract version range, fixed grammar (sdk-contract-v1.md §2.1, decided 2026-08-07): exactly one comparator pair `>=A.B,<C.D`, no whitespace, bounds MAJOR.MINOR."},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z-.]+)?(\\+[0-9A-Za-z-.]+)?$"},
    "name": {"$ref": "#/$defs/langMap"},
    "story": {"$ref": "#/$defs/langMap"},
    "scoring": {"enum": ["casual", "challenge"]},
    "unlock_mode": {"enum": ["manual", "guided"]},
    "participation_mode": {"enum": ["teams", "solo"], "default": "teams", "description": "§3.1: `solo` models teams of one — the import creates one team per participant; nothing else in the document branches on it."},
    "theme": {"type": "string", "minLength": 1},
    "challenges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "title", "text", "minigame", "points"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
          "order": {"type": "integer", "minimum": 1},
          "title": {"$ref": "#/$defs/langMap"},
          "text": {"$ref": "#/$defs/langMap"},
          "minigame": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
              "version": {"type": "string", "pattern": "^>=\\d+\\.\\d+,<\\d+\\.\\d+$", "description": "SemVer range over the referenced minigame's own version — same fixed range grammar as `contract` (§3.2), but a different axis."},
              "host_label": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$", "description": "§3.2: the DNS label this game's HTTP tier is published under (`<host_label>.<event_domain>`). Optional, defaulting to the minigame id — an event-authoring field, deliberately not a manifest field: the label belongs to the story. Same slug grammar as an id; unique within the event over the *effective* labels (after defaulting) and none of the installation's reserved host labels, `callback` always among them (§3.4 check 14). Never rendered to players."}
            }
          },
          "points": {"type": "integer", "minimum": 0},
          "hint_cost": {"type": "integer", "minimum": 0},
          "hint_cap": {"type": "integer", "minimum": 0},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "rewards": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "produces": {"type": "array", "items": {"$ref": "#/$defs/rewardDecl"}},
              "consumes": {"type": "array", "items": {"$ref": "#/$defs/rewardConsumeDecl"}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "langMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "rewardDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$"},
        "type": {"enum": ["ssh_keypair", "password", "token", "ssl_cert"]}
      }
    },
    "rewardConsumeDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$"}
      }
    }
  }
}
